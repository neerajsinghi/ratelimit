{
  "name": "@neerajsinghi/nest-ratelimit",
  "version": "0.1.0",
  "description": "Distributed rate limiting for NestJS on Redis (GCRA and sliding window), with the same Lua scripts and semantics as the Go module github.com/neerajsinghi/ratelimit.",
  "keywords": [
    "nestjs",
    "rate-limit",
    "ratelimit",
    "redis",
    "gcra",
    "sliding-window",
    "throttle",
    "ioredis"
  ],
  "author": "Neeraj Singhi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neerajsinghi/ratelimit.git",
    "directory": "nestjs"
  },
  "homepage": "https://github.com/neerajsinghi/ratelimit#readme",
  "bugs": {
    "url": "https://github.com/neerajsinghi/ratelimit/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "embed-lua": "node tools/embed-lua.mjs",
    "prebuild": "npm run embed-lua",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "npm run embed-lua",
    "test": "jest",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "ioredis": "^5.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "ioredis": "^5.11.1",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
